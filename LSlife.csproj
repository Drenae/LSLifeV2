<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>LSlife</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <GtaVPath Condition="'$(GtaVPath)' == ''">D:\Program Files\Rockstar Games\Grand Theft Auto V Legacy</GtaVPath>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup />
  <ItemGroup>
    <EmbeddedResource Include="assets\\hud_background.png" LogicalName="LSlife.HudBackground" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="ScriptHookVDotNet2">
      <HintPath>$(GtaVPath)\ScriptHookVDotNet2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NativeUI">
      <HintPath>$(GtaVPath)\scripts\NativeUI.dll</HintPath>
    </Reference>
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Core" />
    <Reference Include="iFruitAddon2">
      <HintPath>$(GtaVPath)\scripts\iFruitAddon2.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>